# 실제 값을 채운 뒤 .env 로 복사한다. .env 는 커밋되지 않는다. (.gitignore 등록됨)
# 값이 GitHub·Notion·카카오톡에 한 번이라도 올라갔다면 삭제로 끝내지 말고 반드시 재발급한다.

# Google Cloud > Google Auth Platform > OAuth Client (Web Application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 카카오디벨로퍼스 > 내 애플리케이션 > REST API 키 / 보안 > Client Secret
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 자체 JWT 서명 키. 32바이트(256bit) 이상이어야 서버가 뜬다.
#   생성 예: openssl rand -base64 48
JWT_SECRET=

# DB
DB_HOST=localhost
DB_PORT=3306
DB_NAME=jamkkaebi
DB_USERNAME=root
DB_PASSWORD=

# 게임 앱으로 돌아올 커스텀 스킴. Unity 의 intent-filter / CFBundleURLSchemes 와 같아야 한다.
AUTH_DEEP_LINK_URI=jamkkaebi://auth
